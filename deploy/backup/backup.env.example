# Copy to .env.backup in the same folder as compose.yaml. Never commit the copy.
# The database and the scheduler see this file. The web and worker processes do not.

PGBACKREST_STANZA=hivelock
PGBACKREST_PG1_PATH=/var/lib/postgresql/18/docker
PGBACKREST_PG1_USER=agent_platform_admin
PGBACKREST_PG1_SOCKET_PATH=/var/run/postgresql
PGBACKREST_PROCESS_MAX=2
PGBACKREST_LOG_LEVEL_CONSOLE=info
PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_START_FAST=y
PGBACKREST_LOCK_PATH=/tmp/pgbackrest
PGBACKREST_LOG_PATH=/tmp/pgbackrest
PGBACKREST_SPOOL_PATH=/tmp/pgbackrest

# First copy. Any S3-compatible store works.
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/hivelock
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PGBACKREST_REPO1_S3_REGION=eu-central-1
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# path for MinIO and most others, host for AWS.
PGBACKREST_REPO1_S3_URI_STYLE=host
# Encrypted before it leaves the server. openssl rand -base64 48. Without this, the backups cannot be read, so keep it apart from them.
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=
PGBACKREST_REPO1_RETENTION_FULL=4

# Off-site copy, in another region or with another provider, for when the first one is lost too. Comment these out to go without.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/hivelock
PGBACKREST_REPO2_S3_BUCKET=
PGBACKREST_REPO2_S3_ENDPOINT=s3.eu-west-1.amazonaws.com
PGBACKREST_REPO2_S3_REGION=eu-west-1
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
PGBACKREST_REPO2_S3_URI_STYLE=host
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_CIPHER_PASS=
PGBACKREST_REPO2_RETENTION_FULL=4

# Encrypts the nightly dump, a second kind of backup that needs nothing but pg_restore.
BACKUP_PASSPHRASE=
# Copies each dump elsewhere. It sees only encrypted data, with the file as $1.
# BACKUP_OFFSITE_COMMAND=curl --fail --silent --upload-file "$1" "https://storage.example.com/hivelock/$(basename "$1")"

# When each job runs, in UTC. Base backups: full on Sundays, differential on other days. Drills: Mondays.
BACKUP_HOUR=02
DRILL_HOUR=04
