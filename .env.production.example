# Copy to .env.production. Never commit the copy.
NODE_ENV=production
DOMAIN=agents.example.com
PUBLIC_URL=https://agents.example.com

# The limited role the app runs as. The superuser's password and address go in .env.migrate, which the app never sees.
DATABASE_URL=postgres://agent_platform_app:CHANGE_ME@database/agent_platform

# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Back this up separately from the database.
SECRETS_MASTER_KEY=
# The old key, only during a rotation. See docs/key-rotation.md.
SECRETS_MASTER_KEY_PREVIOUS=
BOOTSTRAP_ADMIN_EMAIL=

# Optional. Mail can be set up under Settings instead.
SMTP_URL=
MAIL_FROM=
ALLOWED_PRIVATE_HOSTS=

# How many of each to run. They scale separately. See docs/high-availability.md.
# WEB_REPLICAS=2
# WORKER_REPLICAS=1
# Each web replica holds up to 18 database connections and each worker 25. Raise this with them.
# POSTGRES_MAX_CONNECTIONS=200
# Steps and agent turns one workspace may run at once, across all workers. Keep it below WORKER_CONCURRENCY, so a busy workspace leaves room for others.
# WORKSPACE_WORK_LIMIT=4
# WORKER_CONCURRENCY=5

# Turns on /metrics. openssl rand -hex 32. Monitoring needs this. See docs/monitoring.md.
METRICS_TOKEN=
# A Sentry-compatible address. Errors are sent there with credentials removed. Empty keeps it off.
ERROR_REPORTING_DSN=
# Where alerts and failed runs are sent. Monitoring needs this too.
ALERT_WEBHOOK_URL=

# AI providers are set up in the app, under Settings.
AUDIT_LOG=off

# A commercial licence key, read by the paid package. Without one, a self-hosted server runs as Community. See docs/editions.md.
# It can be saved under Settings instead, which takes priority.
# HIVELOCK_LICENSE_KEY=

# The multi-tenant cloud version. It needs the paid package, and the server refuses to start without it. Leave off for a normal install.
# HOSTED_MODE=true
# Hosted only, and required there. The login for staff actions and support access: a role of its own that can do nothing else.
# Use a different name and password from DATABASE_URL. The migrate step makes the role, and compose keeps this from the worker.
# DATABASE_OPERATOR_URL=postgres://agent_platform_operator:CHANGE_ME@database/agent_platform
