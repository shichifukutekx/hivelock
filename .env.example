# Copy to .env and add your key. Never commit .env.
# Any OpenAI-compatible provider works: changing provider means changing these lines.

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=

# Each agent picks one of these roles. Change the models here, with no code changes.
# FAST and CODING are optional: left empty, those agents use the main model.
LLM_MODEL_MAIN=nvidia/nemotron-3-ultra-550b-a55b
LLM_MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b
LLM_MODEL_CODING=poolside/laguna-xs-2.1
# Used when the role's model is unavailable or rate limited.
LLM_MODEL_FALLBACK=mistralai/mistral-large-4-1t-a52b

# Extra provider-specific request fields, as JSON.
LLM_EXTRA_BODY={}

# Kimi (Moonshot): optional. Leave the key empty to turn it off.
# It is the last fallback, and agents can also choose it with the "kimi" role.
# Use https://api.moonshot.cn/v1 instead if your key is from the China platform.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
# Thinking is off because LangChain may not send Kimi's reasoning back between tool calls.
KIMI_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Example: DeepSeek directly
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_MAIN=deepseek-v4-flash
# LLM_MODEL_FAST=deepseek-v4-flash
# LLM_MODEL_CODING=deepseek-v4-flash
# LLM_MODEL_FALLBACK=deepseek-v4-flash
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Platform foundation
# The app connects as this limited role. db:migrate creates it using the admin connection.
DATABASE_URL=postgres://agent_platform_app:CHANGE_ME@localhost/agent_platform_dev
DATABASE_ADMIN_URL=postgres:///agent_platform_dev
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Losing this key makes stored secrets unreadable.
SECRETS_MASTER_KEY=
# The old key, only during a rotation. See docs/key-rotation.md.
SECRETS_MASTER_KEY_PREVIOUS=
PUBLIC_URL=http://localhost:4320
# Only this address can create the first account.
BOOTSTRAP_ADMIN_EMAIL=

# The platform's own mail, for invitations, email verification and password reset.
# The platform administrator can set this up under Settings instead, which takes priority.
SMTP_URL=
MAIL_FROM=
# Internal hosts connectors may reach, comma-separated. All private addresses are blocked otherwise.
ALLOWED_PRIVATE_HOSTS=

# Observability, all optional.
# Prices per million tokens, for cost figures. Unknown models show as unpriced.
# MODEL_PRICES={"kimi-k2.6":{"input":0,"output":0}}
# Sends span measurements (never content) to an OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Gets a JSON message when a run fails.
ALERT_WEBHOOK_URL=
# Turns on /metrics for Prometheus, using this as a bearer token.
METRICS_TOKEN=

# AI providers are set up in the app, under Settings.

# A commercial licence key, read by the paid package. Without one, a self-hosted server runs as Community. See docs/editions.md.
# It can be saved under Settings instead, which takes priority.
# HIVELOCK_LICENSE_KEY=

# The multi-tenant cloud version. It needs the paid package, and the server refuses to start without it. Leave off for a normal install.
# HOSTED_MODE=true
